# Copiar a .env (nunca se versiona) y completar los valores.
# Formato de las URL: postgresql+psycopg://usuario:clave@host:5432/postgres
# (el nombre de la variable aparece una sola vez por línea).

# Base real (lectura de reglas y registro de consultas).
DATABASE_URL=

# Base SEPARADA para las pruebas de integración, aceptación y e2e (FR-021).
# Debe ser distinta de DATABASE_URL; ver docs/base-de-pruebas.md.
TEST_DATABASE_URL=

# true mientras el médico no apruebe el texto de la salvaguarda de cobertura (FR-020).
SALVAGUARDA_PENDIENTE_APROBACION=true
